function getRTP(i){
  let timeBlock = getTimeBlock();

  
  let seed = (i * 53 + timeBlock * 29 + (i % 6) * 17) % 100;

  if(seed < 25){
    // 🔴 
    return 40 + (seed % 10);    
  } 
  else if(seed < 30){
    // 🟡 
    return 55 + (seed % 20);    
  } 
  else{
    // 🟢 
    return 70 + (seed % 15);   
  }
}

