.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;padding:12px;}
.card{width:100%;height:85%;object-position:80% center;aspect-ratio:3/4; background:#111;border-radius:14px;overflow:hidden;position:relative;cursor:pointer;}
