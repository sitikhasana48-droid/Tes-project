.rtp-text{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:12px;font-weight:bold;color:#000;z-index:2;pointer-events:none;text-shadow:0 0 3px #fff;}
.card .overlay-btn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:80%;height:40px;background:rgba(223,183,5,0.9);color:#000;font-weight:bold;font-size:12px;text-align:center;line-height:40px;opacity:0;transition:opacity 0.3s ease;pointer-events:none;border-radius:6px;}
.card:hover .overlay-btn{opacity:1;pointer-events:auto;}
.popup{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);display:none;justify-content:center;align-items:center;}
.popup-content{width:92%;max-width:360px;background:#1c1c1c;border-radius:16px;overflow:hidden;position:relative;}
.popup-header{background:#dfb705;text-align:center;padding:14px;font-weight:bold;}
