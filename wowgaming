.rtp{position:absolute;bottom:0;left:0;width:100%;height:22px;background:rgba(255,255,255,0.3);border-radius:4px;overflow:hidden;backdrop-filter:blur(4px);}
.rtp-fill{position:relative;height:100%;width:var(--percent,50%);overflow:hidden;border-radius:4px;background:none;}
.rtp-fill::before{content:"";position:absolute;top:0;left:0;width:300%;height:100%;background:linear-gradient(90deg,#22c55e 0%,#4ade80 20%,#22c55e 40%,#4ade80 60%,#22c55e 80%,#4ade80 100%);background-size:300% 100%;animation:moveForward 6s linear infinite;}
.rtp-fill.high::before{background:repeating-linear-gradient(45deg,rgba(255,255,255,0.2),rgba(255,255,255,0.2) 10px,transparent 10px,transparent 20px),linear-gradient(90deg,#22c55e,#4ade80,#22c55e);}
.rtp-fill.mid::before{background:repeating-linear-gradient(45deg,rgba(255,255,255,0.2),rgba(255,255,255,0.2) 10px,transparent 10px,transparent 20px),linear-gradient(90deg,#facc15,#fde047,#facc15);}
.rtp-fill.low::before{background:repeating-linear-gradient(45deg,rgba(255,255,255,0.2),rgba(255,255,255,0.2) 10px,transparent 10px,transparent 20px),linear-gradient(90deg,#ef4444,#f87171,#ef4444);}
