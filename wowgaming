function getBet(i){
  const timeBlock = getTimeBlock();

  // Pilihan base acak, kelipatan 200
  const baseOptions = [200, 400, 600];
  let base = baseOptions[(i + timeBlock) % baseOptions.length];

  // Pilih multiplier acak 1-5, kelipatan 200
  let multiplier = Math.floor(Math.random() * 5) + 1; // 1 sampai 5
  let maxBet = base * multiplier;

  // Batas maksimal agar tidak terlalu besar
  if(maxBet > 1400) maxBet = 1400;

 
  let minBet = Math.floor(Math.random() * (maxBet / 200)) * 200;
  if(minBet < base) minBet = base; 

  return minBet + " - " + maxBet;
}

